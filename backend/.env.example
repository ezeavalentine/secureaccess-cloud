APP_ENV=development
DEMO_MODE=true
COOKIE_SECURE=false
# Generated local keys live in data/local-keys.json with mode 0600.
# Production template: supply all values through your secret manager.
# APP_ENV=production
# DEMO_MODE=false
# COOKIE_SECURE=true
# SECRET_KEY=<independent random string, at least 32 characters>
# AUDIT_HMAC_KEY=<different random string, at least 32 characters>
# ENCRYPTION_KEY=<Fernet key>
# DATABASE_URL=postgresql+psycopg://app:password@database:5432/secureaccess?sslmode=require
# AWS_EXTERNAL_ID=<random external ID, at least 24 characters>
# AWS_ORCHESTRATOR_ARN=arn:aws:iam::BROKER_ACCOUNT_ID:role/SecureAccessOrchestratorRole
# AWS_REGION=us-east-1
# AWS_ACCOUNTS_JSON=[{"id":"TARGET_ACCOUNT_ID","name":"Production","environment":"production","risk_multiplier":1.5,"management_role_arn":"arn:aws:iam::TARGET_ACCOUNT_ID:role/SecureAccessRevokerRole"}]
# AUDIT_DYNAMODB_TABLE=secureaccess_audit_logs
# PUBLIC_URL=https://access.example.com
# ALLOWED_ORIGINS=["https://access.example.com"]
# TRUSTED_PROXY_CIDRS=["127.0.0.1/32","ALB_SUBNET_CIDR"]
# LIVE_MAX_DURATION_MINUTES=60
# CLOUDTRAIL_REGIONS=["us-east-1","eu-west-1"]
# CLOUDTRAIL_MAX_PAGES=20
# TICKET_VERIFICATION_REQUIRED=true
# JIRA_URL=https://company.atlassian.net
# JIRA_USERNAME=broker@example.com
# JIRA_TOKEN=<API token with issue read access>
# SERVICENOW_URL=https://company.service-now.com
# SERVICENOW_USERNAME=<read-only integration user>
# SERVICENOW_PASSWORD=<integration password>
# OIDC_CLIENT_ID=<client ID>
# OIDC_CLIENT_SECRET=<client secret>
# OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=<SMTP user>
# SMTP_PASSWORD=<SMTP password>
# SMTP_FROM=access@example.com
# SMTP_STARTTLS=true
# For multiple API processes, migrate once and run a separate worker.
# AUTO_MIGRATE=false
# WORKER_MODE=external
